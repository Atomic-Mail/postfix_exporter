# syntax=docker/dockerfile:1

ARG GO_VERSION=1.27.4

FROM --platform=$BUILDPLATFORM golang:${GO_VERSION}-bookworm AS build

ARG TARGETOS
ARG TARGETARCH
ARG VERSION=0.21.2-atomicmail.1
ARG REVISION=unknown
ARG BUILD_DATE

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . ./
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build \
      -mod=readonly \
      -trimpath \
      -tags=nosystemd,nodocker,nokubernetes \
      -ldflags="-w -s -buildid= \
        -X github.com/prometheus/common/version.Version=${VERSION} \
        -X github.com/prometheus/common/version.Revision=${REVISION} \
        -X github.com/prometheus/common/version.Branch=hardened-build \
        -X github.com/prometheus/common/version.BuildDate=${BUILD_DATE}" \
      -o /out/postfix_exporter ./

FROM scratch

ARG VERSION=0.21.2-atomicmail.1
ARG REVISION=unknown
ARG BUILD_DATE

LABEL org.opencontainers.image.authors="AtomicMail" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.source="https://github.com/Atomic-Mail/postfix_exporter" \
      org.opencontainers.image.title="postfix_exporter" \
      org.opencontainers.image.vendor="AtomicMail" \
      org.opencontainers.image.version="${VERSION}"

COPY --from=build /out/postfix_exporter /postfix_exporter
COPY LICENSE /LICENSE

EXPOSE 9154
ENTRYPOINT ["/postfix_exporter"]
